# Salvation CRM — 서버 환경변수
# 이 파일은 예시다. 실제 값은 여기 적지 말고 Vercel 대시보드
# (Settings ▸ Environment Variables) 또는 로컬 .env.local 에만 넣는다.
# .env.local 은 .gitignore 로 커밋에서 제외된다.

# Airtable 개인 액세스 토큰 (pat... 로 시작)
# 필요 스코프: data.records:read / data.records:write
# 접근 베이스: 고객관리 (appHlpNTeCXrHKArz)
AIRTABLE_TOKEN=

# 기본값이 고객관리 베이스라 보통 비워 둬도 된다.
AIRTABLE_BASE_ID=appHlpNTeCXrHKArz

# @BotFather 에서 만든 봇 토큰 (123456789:AA... 형식)
TELEGRAM_BOT_TOKEN=

# 알림 받을 대화 ID. 쉼표로 여러 개 지정 가능. 그룹은 -100... 형식의 음수.
TELEGRAM_CHAT_ID=

# (선택) /api/health?deep=1 을 보호할 키
ADMIN_KEY=

# (선택) 사이트를 Vercel 외 도메인에도 올렸다면 쉼표로 나열
ALLOWED_ORIGINS=
